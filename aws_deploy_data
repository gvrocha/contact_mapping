#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"

if [ ! -f "${DIR}/deploy.conf" ]; then
    echo "Missing deploy.conf — copy deploy.conf.example to deploy.conf and fill in your bucket/region." >&2
    exit 1
fi
# shellcheck source=/dev/null
source "${DIR}/deploy.conf"

echo "Pushing data files to ${BUCKET} ..."

# shellcheck source=code/deploy_data_files.sh
source "${DIR}/code/deploy_data_files.sh"
for f in "${DATA_FILES[@]}"; do
    if [ ! -f "${DIR}/${f}" ]; then
        echo "  skipping ${f} (not found locally)"
        continue
    fi
    type=()
    case "${f}" in *.geojson) type=(--content-type "application/geo+json") ;; esac
    aws s3 cp "${DIR}/${f}" "${BUCKET}/${f}" --region "${REGION}" "${type[@]}"
done

echo "Done. Data updated at ${PUBLIC_URL}"
