#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
BRANCH="gh-pages"
WORKTREE_DIR="$(mktemp -d)"
cd "${DIR}"

cleanup() {
    git worktree remove "${WORKTREE_DIR}" --force 2>/dev/null || true
}
trap cleanup EXIT

echo "Preparing ${BRANCH} worktree..."
# Sync local branch to remote so our push is always a fast-forward.
# CI also pushes to this branch, so the local pointer may be stale.
git fetch origin "${BRANCH}" 2>/dev/null || true
if git show-ref --verify --quiet "refs/heads/${BRANCH}"; then
    git branch -f "${BRANCH}" "origin/${BRANCH}" 2>/dev/null || true
    git worktree add "${WORKTREE_DIR}" "${BRANCH}"
else
    git worktree add --orphan -b "${BRANCH}" "${WORKTREE_DIR}"
fi

echo "Syncing site + data into ${BRANCH}..."
# Data folders are excluded from --delete so files this run cannot regenerate
# (e.g. qrz_qso_table.tsv when run from CI) are kept.
rsync -a --delete --exclude ".git" --exclude "data_output/" --exclude "data_reference/" \
    "${DIR}/site/" "${WORKTREE_DIR}/"
touch "${WORKTREE_DIR}/.nojekyll"

# shellcheck source=code/deploy_data_files.sh
source "${DIR}/code/deploy_data_files.sh"
for f in "${DATA_FILES[@]}"; do
    if [ -f "${DIR}/${f}" ]; then
        mkdir -p "$(dirname "${WORKTREE_DIR}/${f}")"
        cp "${DIR}/${f}" "${WORKTREE_DIR}/${f}"
    else
        echo "  skipping ${f} (not found locally)"
    fi
done

cd "${WORKTREE_DIR}"
git add -A
if git diff --cached --quiet; then
    echo "No changes to deploy."
else
    git commit -m "Deploy $(date -u +'%Y-%m-%dT%H:%M:%SZ')" --quiet
    git push origin "${BRANCH}"
fi

echo "Done. If GitHub Pages isn't enabled yet: Settings -> Pages -> Source: Deploy from branch '${BRANCH}' / (root)."
